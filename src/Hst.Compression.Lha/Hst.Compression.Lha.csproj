<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Description>Hst Compression Lha is a library for creating lha archives and extracting -lh2- and -lh3- methods based on LHa for UNIX. Distributed under the LHa for UNIX redistribution terms, see license.txt.</Description>
        <PackageTags>Hst;Compression;Lha;Lzh</PackageTags>
    </PropertyGroup>

    <PropertyGroup>
        <!-- LHa for UNIX redistribution terms replace MIT license expression from Directory.Build.props -->
        <PackageLicenseExpression></PackageLicenseExpression>
        <PackageLicenseFile>license.txt</PackageLicenseFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="NuGet\readme.md" Pack="true" PackagePath="\" />
        <None Include="license.txt" Pack="true" PackagePath="\" />
        <None Include="licenses\**" Pack="true" PackagePath="licenses\" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Hst.Compression\Hst.Compression.csproj" />
    </ItemGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="Hst.Compression.Lha.Tests" />
    </ItemGroup>
</Project>
